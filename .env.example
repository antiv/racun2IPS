# GEMINI API ključevi (prosleđuju se pri build-u: fvm flutter run --dart-define-from-file=.env)
# Mogu se definisati odvojeno sa restrikcijama na nivou platforme:
GEMINI_API_KEY_ANDROID="YOUR_GEMINI_API_KEY_ANDROID"
GEMINI_API_KEY_IOS="YOUR_GEMINI_API_KEY_IOS"

# Ili zajednički fallback ključ:
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
